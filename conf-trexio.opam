bug-reports: "https://github.com/trex-coe/trexio_ocaml/issues"
tags: [ "system" "library" ]
depends: [
  "conf-pkg-config" {build}
  "conf-gcc" {build}
]
build: [
  ["sh" "-c" "pkg-config --exists trexio || ./setup.sh install-c-library \"%{prefix}%\""]
]
