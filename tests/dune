(test
 (name trexio_tests)
 (modules trexio_tests)
 (libraries trexio unix)
 (deps ../lib/dlltrexio_stubs.so trexio_tests.bc trexio_tests.exe)
 (modes byte native)
 (action
  (bash
   "export LD_LIBRARY_PATH=\"../lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\";
    export CAML_LD_LIBRARY_PATH=\"../lib${CAML_LD_LIBRARY_PATH:+:$CAML_LD_LIBRARY_PATH}\";
    exec ./%{test}")))
